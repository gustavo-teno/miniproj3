# copie para .env.local (o .env.local nunca vai para o git)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Só em desenvolvimento, enquanto o login não existe (guia 01, Passo 0):
# o front manda X-User-Id com este número. Tire o # da linha abaixo e suba o
# backend com o atalho ligado (o make dev-back sozinho não liga):
#   DEBUG=true make dev-back
# Depois de mudar este arquivo, reinicie o make dev-front.
# NEXT_PUBLIC_DEV_USER_ID=1
