__pycache__/
*.pyc
.venv/
.pytest_cache/

# node
node_modules/
.next/
out/
# cache do tsc (npx tsc --noEmit gera)
*.tsbuildinfo

# editores/os
.DS_Store
.vscode/
.idea/

